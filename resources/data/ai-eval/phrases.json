      "expect": [
        {
          "anyOf": [
            {
              "tool": "rotate",
              "args": {
                "degrees": 270,
                "direction": "clockwise"
              }
            },
            {
              "tool": "rotate",
              "args": {
                "degrees": 90,
                "direction": "counterclockwise"
              }
            }
          ]
        }
      ]
    },
