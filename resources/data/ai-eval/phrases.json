{
  "schemaVersion": 1,
  "description": "FR/EN phrase -> expected tool calls for the editor agent (PLAN 6.8). Fixture: a 16x16 texture.",
  "cases": [
    {
      "id": "rotate-left-90",
      "context": "editor",
      "fixture": "sample16",
      "fr": "tourne de 90 à gauche",
      "en": "rotate it 90 degrees to the left",
      "expect": [
        {
          "tool": "rotate",
          "args": {
            "degrees": 90,
            "direction": "counterclockwise"
          }
        }
      ]
    },
    {
      "id": "rotate-right-90",
      "context": "editor",
      "fixture": "sample16",
      "fr": "pivote de 90 degrés vers la droite",
      "en": "turn it 90° to the right",
      "expect": [
        {
          "tool": "rotate",
          "args": {
            "degrees": 90,
            "direction": "clockwise"
          }
        }
      ]
    },
    {
      "id": "rotate-180",
      "context": "editor",
      "fixture": "sample16",
      "fr": "retourne-la à l'envers, 180 degrés",
      "en": "rotate it 180 degrees",
      "expect": [
        {
          "tool": "rotate",
          "args": {
            "degrees": 180
          }
        }
      ]
    },
    {
      "id": "rotate-270-cw",
      "context": "editor",
      "fixture": "sample16",
