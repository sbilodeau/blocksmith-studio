      "order": 40,
      "include": [
        "item/*_sword.png",
        "item/*_spear*.png",
        "item/bow.png",
        "item/bow_*.png",
        "item/crossbow*.png",
        "item/{arrow,spectral_arrow,mace,trident}.png",
        "item/tipped_arrow*.png"
      ]
