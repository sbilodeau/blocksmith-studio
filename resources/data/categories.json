      "icon": "assets/minecraft/textures/block/grass_block_side.png",
      "order": 10,
      "include": [
        "block/**",
        "item/*_door.png",
        "item/*_sign.png",
        "item/*candle.png",
        "item/{bamboo,bell,brewing_stand,cake,campfire,cauldron,chain,comparator,flower_pot,hopper,kelp,lantern,mangrove_propagule,nether_sprouts,pink_petals,pitcher_plant,pointed_dripstone,repeater,sea_pickle,seagrass,soul_campfire,soul_lantern,sugar_cane}.png"
      ]
    },
    {
      "id": "ores",
      "i18nKey": "category.ores",
      "icon": "assets/minecraft/textures/block/diamond_ore.png",
      "order": 20,
      "include": [
        "block/*_ore.png",
        "block/raw_*_block.png",
        "block/ancient_debris_*.png",
        "item/raw_*.png"
      ]
    },
    {
