        "item/{mushroom_stew,rabbit_stew,suspicious_stew,dried_kelp,sweet_berries,glow_berries,chorus_fruit}.png",
        "item/{beef,cooked_beef,porkchop,cooked_porkchop,mutton,cooked_mutton,chicken,cooked_chicken,rabbit,cooked_rabbit}.png",
        "item/{cod,cooked_cod,salmon,cooked_salmon,tropical_fish,pufferfish}.png",
