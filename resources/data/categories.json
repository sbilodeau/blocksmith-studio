      "i18nKey": "category.materials",
      "icon": "assets/minecraft/textures/item/iron_ingot.png",
      "order": 70,
      "include": [
        "item/*_ingot.png",
        "item/*_nugget.png",
        "item/*_dye.png",
        "item/*_pottery_sherd.png",
        "item/*_seeds.png",
        "item/netherite_upgrade_smithing_template.png",
        "item/{diamond,emerald,lapis_lazuli,quartz,amethyst_shard,echo_shard,coal,charcoal,netherite_scrap}.png",
        "item/{redstone,glowstone_dust,gunpowder,blaze_powder,blaze_rod,breeze_rod,sugar,wheat}.png",
        "item/{stick,string,feather,flint,leather,rabbit_hide,rabbit_foot,bone,bone_meal,slime_ball,magma_cream}.png",
