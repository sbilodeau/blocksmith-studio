        "item/{prismarine_shard,prismarine_crystals,heart_of_the_sea,nautilus_shell,phantom_membrane,shulker_shell}.png",
        "item/{turtle_scute,armadillo_scute,clay_ball,brick,nether_brick,resin_brick,resin_clump,honeycomb}.png",
        "item/{ink_sac,glow_ink_sac,paper,disc_fragment_5,nether_wart,pitcher_pod,cocoa_beans,egg}.png"
      ]
    },
    {
      "id": "entities",
      "i18nKey": "category.entities",
      "icon": "assets/minecraft/textures/entity/creeper/creeper.png",
      "order": 80,
      "include": ["entity/**"],
      "exclude": ["entity/equipment/**"]
    },
    {
      "id": "gui",
      "i18nKey": "category.gui",
      "icon": "assets/minecraft/textures/gui/sprites/hud/heart/full.png",
      "order": 90,
      "include": ["gui/**", "font/**"]
    },
    {
      "id": "particles",
      "i18nKey": "category.particles",
      "icon": "assets/minecraft/textures/particle/flame.png",
      "order": 100,
      "include": ["particle/**"]
    },
    {
      "id": "environment",
      "i18nKey": "category.environment",
      "icon": "assets/minecraft/textures/environment/sun.png",
      "order": 110,
      "include": [
        "environment/**",
        "misc/**",
        "painting/**",
        "mob_effect/**",
        "map/**",
        "colormap/**",
        "effect/**"
      ]
    },
    {
      "id": "other",
      "i18nKey": "category.other",
      "icon": "assets/minecraft/textures/item/bundle.png",
      "order": 1000,
      "include": []
    }
