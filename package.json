{
  "name": "blocksmith-studio",
  "productName": "Blocksmith Studio",
  "version": "0.0.0-dev",
  "description": "Desktop Minecraft Java resource pack creator with a pixel editor, live 3D preview and AI agents",
  "main": "./out/main/index.js",
  "author": "Stephane Bilodeau",
  "license": "MIT",
  "homepage": "https://github.com/sbilodeau/blocksmith-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/sbilodeau/blocksmith-studio.git"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "package": "npm run build && electron-builder --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "package:win": "npm run build && electron-builder --win --publish never",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "calver": "node scripts/calver.mjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.6.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^21.0.4",
    "naive-ui": "^2.45.3",
    "pinia": "^4.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.1.0",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-i18n": "^11.4.20",
    "vue-router": "^5.5.1",
    "vue-tsc": "^3.3.13",
    "zod": "^4.6.7"
  }
}
